	followBtn.Text = followOn and "SEGUIR RED KNIGHT: ON" or "SEGUIR RED KNIGHT: OFF"

	if followConn then
		followConn:Disconnect()
		followConn = nil
	end

	if followOn then
		followConn = RunService.RenderStepped:Connect(function()
